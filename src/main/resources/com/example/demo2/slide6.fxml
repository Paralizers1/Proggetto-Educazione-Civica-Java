<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>
<?import javafx.scene.text.Text?>
<?import javafx.scene.text.TextFlow?>

<VBox alignment="CENTER_LEFT" fillWidth="false" spacing="20.0" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1">
    <padding>
        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
    </padding>
    <Label alignment="CENTER" contentDisplay="CENTER" maxWidth="1.7976931348623157E308" text="Il problema etico: quando il passato decide il futuro" textAlignment="CENTER" wrapText="true" VBox.vgrow="NEVER">
        <font>
            <Font name="System Bold" size="35.0" />
        </font>
    </Label>
    <TextFlow maxHeight="1.7976931348623157E308" maxWidth="1.7976931348623157E308">
        <Text text="Quale problema etico vediamo?">
            <font>
                <Font name="System Bold" size="23.0" />
            </font></Text>
        <Text text="&#10;">
            <font>
                <Font name="System" size="4.0" />
            </font></Text>
        <Text text="Il software soffre di bias storico: non valuta solo il talento attuale, ma replica le discriminazioni del passato, trasformandole in una decisione automatica apparentemente neutrale.">
            <font>
                <Font name="System" size="20.0" />
            </font></Text>
        <Text text="&#10;&#10;">
            <font>
                <Font name="System" size="20.0" />
            </font></Text>
        <Text text="Chi viene danneggiato?">
            <font>
                <Font name="System Bold" size="23.0" />
            </font></Text>
        <Text text="&#10;">
            <font>
                <Font name="System" size="20.0" />
            </font></Text>
        <Text text="Vengono danneggiate:">
            <font>
                <Font name="System Bold" size="20.0" />
            </font></Text>
        <Text text="&#10;">
            <font>
                <Font name="System" size="18.0" />
            </font></Text>
        <Text text="- Le donne qualificate, escluse ingiustamente dai colloqui.">
            <font>
                <Font name="System" size="20.0" />
            </font></Text>
        <Text text="&#10;">
            <font>
                <Font name="System" size="20.0" />
            </font></Text>
        <Text text="- L’azienda, che rischia di perdere talenti validi.">
            <font>
                <Font name="System" size="20.0" />
            </font></Text>
        <Text text="&#10;">
            <font>
                <Font name="System" size="20.0" />
            </font></Text>
        <Text text="- La società, perché la parità di genere viene ostacolata invece che favorita.">
            <font>
                <Font name="System" size="20.0" />
            </font></Text>
    </TextFlow>
</VBox>
