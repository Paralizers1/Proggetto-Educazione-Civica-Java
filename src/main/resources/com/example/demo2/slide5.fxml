<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>
<?import javafx.scene.text.Text?>
<?import javafx.scene.text.TextFlow?>

<VBox alignment="CENTER" fillWidth="false" spacing="20.0" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1">
    <padding>
        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
    </padding>
    <Label text="L’etica come bussola della tecnologia">
        <font>
            <Font name="System Bold" size="35.0" />
        </font>
    </Label>
    <TextFlow maxHeight="1.7976931348623157E308" maxWidth="1.7976931348623157E308">
        <Text text="Per semplificare, possiamo leggere l’etica dell’IA attraverso tre pilastri fondamentali:">
            <font>
                <Font name="System" size="20.0" />
            </font></Text>
        <Text text="&#10;&#10;">
            <font>
                <Font name="System" size="22.0" />
            </font></Text>
        <Text text="- Responsabilità" textAlignment="JUSTIFY">
            <font>
                <Font name="System Bold" size="22.0" />
            </font></Text>
        <Text text="&#10;">
            <font>
                <Font name="System" size="20.0" />
            </font></Text>
        <Text text="Chiedersi chi risponde delle conseguenze e se una scelta può danneggiare qualcuno."  textAlignment="JUSTIFY">
            <font>
                <Font name="System" size="20.0" />
            </font></Text>
        <Text text="&#10;">
            <font>
                <Font name="System" size="20.0" />
            </font></Text>
        <Text text="- Giustizia"  textAlignment="JUSTIFY">
            <font>
                <Font name="System Bold" size="22.0" />
            </font></Text>
        <Text text="&#10;"  textAlignment="JUSTIFY">
            <font>
                <Font name="System" size="20.0" />
            </font></Text>
        <Text text="Garantire equità, evitando discriminazioni, bias e vantaggi ingiusti." textAlignment="JUSTIFY">
            <font>
                <Font name="System" size="20.0" />
            </font></Text>
        <Text text="&#10;" textAlignment="JUSTIFY">
            <font>
                <Font name="System" size="20.0" />
            </font></Text>
        <Text text="- Trasparenza" textAlignment="JUSTIFY">
            <font>
                <Font name="System Bold"  size="22.0" />
            </font></Text>
        <Text text="&#10;" textAlignment="JUSTIFY">
            <font>
                <Font name="System" size="20.0" />
            </font></Text>
        <Text text="Rendere comprensibili le decisioni, evitando sistemi a " textAlignment="JUSTIFY">
            <font>
                <Font name="System" size="20.0" />
            </font></Text>
        <Text text="“scatola nera”" textAlignment="JUSTIFY">
            <font>
                <Font name="System Italic" size="20.0" />
            </font></Text>
        <Text text=" impossibili da spiegare." textAlignment="JUSTIFY">
            <font>
                <Font name="System" size="20.0" />
            </font></Text>
        <Text text="&#10;&#10;" textAlignment="JUSTIFY">
            <font>
                <Font name="System Bold" size="20.0" />
            </font></Text>
        <Text text="L’etica è la bussola che impedisce alla potenza tecnica di calpestare i diritti delle persone." textAlignment="JUSTIFY">
            <font>
                <Font name="System Bold" size="20.0" />
            </font></Text>
    </TextFlow>
</VBox>
