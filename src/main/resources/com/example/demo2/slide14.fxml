<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>
<?import javafx.scene.text.Text?>
<?import javafx.scene.text.TextFlow?>

<VBox alignment="TOP_CENTER" fillWidth="false" spacing="20.0" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1">
    <padding>
        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
    </padding>
    <Label text="Basta saper programmare bene o serve anche un'etica personale?" wrapText="true">
        <font>
            <Font name="System Bold" size="35.0" />
        </font>
    </Label>
    <TextFlow maxHeight="1.7976931348623157E308" maxWidth="1.7976931348623157E308">
        <Text text="Saper programmare bene è necessario, ma non sufficiente.">
            <font>
                <Font name="System Bold" size="20.0" />
            </font></Text>
        <Text text=" Un codice può essere pulito, efficiente e senza errori, ma essere comunque usato per discriminare, sorvegliare o manipolare.">
            <font>
                <Font name="System" size="20.0" />
            </font></Text>
        <Text text="&#10;&#10;">
            <font>
                <Font name="System" size="20.0" />
            </font></Text>
        <Text text="La tecnica è il motore che permette al sistema di funzionare; l’etica è il timone che decide la direzione.">
            <font>
                <Font name="System" size="20.0" />
            </font></Text>
        <Text text="&#10;&#10;">
            <font>
                <Font name="System" size="20.0" />
            </font></Text>
        <Text text="Senza una responsabilità personale, il programmatore rischia di diventare solo un esecutore nelle mani di chi ha il potere.">
            <font>
                <Font name="System" size="20.0" />
            </font></Text>
        <Text text="&#10;&#10;">
            <font>
                <Font name="System Bold" size="20.0" />
            </font></Text>
        <Text text="Programmare bene non significa solo far funzionare il codice, ma capire quali conseguenze può produrre.">
            <font>
                <Font name="System Bold" size="20.0" />
            </font></Text>
    </TextFlow>
</VBox>
