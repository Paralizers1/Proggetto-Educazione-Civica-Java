<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>
<?import javafx.scene.text.Text?>
<?import javafx.scene.text.TextFlow?>

<VBox alignment="CENTER" fillWidth="false" spacing="20.0" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1">
    <padding>
        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
    </padding>
    <Label text="Chi controlla che l'IA non faccia danni?">
        <font>
            <Font name="System Bold" size="35.0" />
        </font>
    </Label>
    <TextFlow maxHeight="1.7976931348623157E308" maxWidth="1.7976931348623157E308">
        <Text text="Il controllo deve essere condiviso: non basta fidarsi del software.">
            <font>
                <Font name="System Bold Italic" size="20.0" />
            </font></Text>
        <Text text="&#10;">
            <font>
                <Font name="System" size="20.0" />
            </font></Text>
        <Text text="- Le istituzioni stabiliscono le regole, come l’AI Act europeo, che impone obblighi più severi per le IA usate in ambiti delicati come il lavoro." textAlignment="JUSTIFY">
            <font>
                <Font name="System" size="20.0" />
            </font></Text>
        <Text text="&#10;">
            <font>
                <Font name="System" size="20.0" />
            </font></Text>
        <Text text="- Le aziende devono progettare, testare e monitorare i sistemi, evitando bias, errori e decisioni non spiegabili." textAlignment="JUSTIFY">
            <font>
                <Font name="System" size="20.0" />
            </font></Text>
        <Text text="&#10;">
            <font>
                <Font name="System" size="20.0" />
            </font></Text>
        <Text text="- Gli utenti e i cittadini devono usare l’IA in modo critico, chiedere trasparenza e segnalare risultati ingiusti." textAlignment="JUSTIFY">
            <font>
                <Font name="System" size="20.0" />
            </font></Text>
        <Text text="&#10;&#10;">
            <font>
                <Font name="System" size="20.0" />
            </font></Text>
        <Text text="Un’IA sicura non nasce solo da un buon codice, ma da regole, controlli e responsabilità umana.">
            <font>
                <Font name="System Bold" size="20.0" />
            </font></Text>
    </TextFlow>
</VBox>
